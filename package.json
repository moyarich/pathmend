{
  "name": "pathmend",
  "displayName": "PathMend",
  "description": "Find broken file paths in config files and Markdown/MDX documents after you move or rename something: package.json main/bin/exports/files/scripts, tsconfig extends/include/references/paths/typeRoots, Dockerfile COPY/ADD, docker-compose build context, GitHub Actions working-directory/uses/run scripts, GitLab CI include, CODEOWNERS and launch.json. Suggests the moved file and updates references on rename. Only checks whether paths exist inside the workspace - runs no processes, so it works in untrusted workspaces.",
  "version": "0.1.0",
  "publisher": "jaytankdev",
  "repository": {
    "type": "git",
    "url": "https://github.com/jay-tank/pathmend.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "broken path",
    "rename",
    "move file",
    "package.json",
    "tsconfig",
    "dockerfile",
    "docker-compose",
    "github actions",
    "codeowners",
    "gitlab ci",
    "devops",
    "markdown",
    "mdx"
  ],
  "activationEvents": [
    "workspaceContains:**/package.json",
    "workspaceContains:**/tsconfig*.json",
    "workspaceContains:**/Dockerfile*",
    "workspaceContains:.github/workflows",
    "workspaceContains:**/.gitlab-ci.yml",
    "workspaceContains:**/*.md",
    "workspaceContains:**/*.mdx",
    "onStartupFinished",
    "onView:pathmend.references",
    "onView:pathmend.details"
  ],
  "main": "./extension.js",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#3A1A06",
    "theme": "dark"
  },
  "license": "MIT",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "pathmend.scan",
        "title": "Scan workspace",
        "category": "PathMend",
        "icon": "$(refresh)"
      },
      {
        "command": "pathmend.showBroken",
        "title": "Show broken references",
        "category": "PathMend",
        "icon": "$(list-filter)"
      },
      {
        "command": "pathmend.openReference",
        "title": "Open reference",
        "category": "PathMend"
      },
      {
        "command": "pathmend.applyFix",
        "title": "Apply suggested path",
        "category": "PathMend",
        "icon": "$(lightbulb-autofix)"
      },
      {
        "command": "pathmend.showReferenceDetails",
        "title": "Show reference details",
        "category": "PathMend"
      },
      {
        "command": "pathmend.openDetails",
        "title": "Open Reference Details",
        "category": "PathMend",
        "icon": "$(open-preview)"
      },
      {
        "command": "pathmend.exportResults",
        "title": "Export Results",
        "category": "PathMend",
        "icon": "$(export)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pathmend",
          "title": "PathMend",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "pathmend": [
        {
          "id": "pathmend.references",
          "name": "Broken References",
          "icon": "media/activity.svg",
          "contextualTitle": "PathMend"
        },
        {
          "type": "webview",
          "id": "pathmend.details",
          "name": "Reference Details",
          "icon": "media/activity.svg",
          "contextualTitle": "PathMend",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "pathmend.references",
        "contents": "PathMend is turned off.\n[Open PathMend Settings](command:workbench.action.openSettings?%5B%22pathmend.%22%5D)",
        "when": "!config.pathmend.enabled"
      },
      {
        "view": "pathmend.references",
        "contents": "Open a folder to check the file paths in its config files.\n[Open Folder](command:workbench.action.files.openFolder)",
        "when": "config.pathmend.enabled && workbenchState == empty"
      },
      {
        "view": "pathmend.references",
        "contents": "No broken paths found.\nPathMend checks the file paths in package.json, tsconfig / jsconfig, Dockerfile COPY / ADD, Compose build contexts, GitHub Actions workflows, GitLab CI includes, CODEOWNERS  .vscode/launch.json, Markdown and MDX, and offers to update them when you rename a file in VS Code.\n[Scan workspace](command:pathmend.scan)",
        "when": "config.pathmend.enabled && workbenchState != empty"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "pathmend.openReference",
          "when": "false"
        },
        {
          "command": "pathmend.applyFix",
          "when": "false"
        },
        {
          "command": "pathmend.showReferenceDetails",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "pathmend.showBroken",
          "when": "view == pathmend.references",
          "group": "navigation@1"
        },
        {
          "command": "pathmend.scan",
          "when": "view == pathmend.references",
          "group": "navigation@2"
        },
        {
          "command": "pathmend.scan",
          "when": "view == pathmend.details",
          "group": "navigation@1"
        },
        {
          "command": "pathmend.openDetails",
          "when": "view == pathmend.references",
          "group": "navigation@3"
        },
        {
          "submenu": "pathmend.menu",
          "when": "view == pathmend.references || view == pathmend.details",
          "group": "1_pathmend"
        },
        {
          "command": "pathmend.exportResults",
          "when": "view == pathmend.details",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "pathmend.applyFix",
          "when": "view == pathmend.references && viewItem == finding.fixable",
          "group": "inline@1"
        },
        {
          "command": "pathmend.applyFix",
          "when": "view == pathmend.references && viewItem == finding.fixable",
          "group": "1_actions@1"
        },
        {
          "command": "pathmend.showReferenceDetails",
          "when": "view == pathmend.references && (viewItem == finding || viewItem == finding.fixable)",
          "group": "1_actions@2"
        }
      ],
      "pathmend.menu": [
        {
          "command": "pathmend.openDetails",
          "group": "1_views@1"
        },
        {
          "command": "pathmend.showBroken",
          "group": "1_views@2"
        },
        {
          "command": "pathmend.scan",
          "group": "2_actions@1"
        },
        {
          "command": "pathmend.exportResults",
          "group": "2_actions@2"
        }
      ]
    },
    "configuration": {
      "title": "PathMend",
      "properties": {
        "pathmend.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable PathMend diagnostics."
        },
        "pathmend.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/dist/**"
          ],
          "description": "Glob patterns (relative to the workspace folder) excluded from the scan. Config files here are not read, and references pointing here are not checked."
        },
        "pathmend.ignoreReferences": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/build/**",
            "**/out/**",
            "**/coverage/**",
            "**/target/**",
            "**/.next/**"
          ],
          "description": "Glob patterns for build output folders. References that point into them (for example \"main\": \"build/index.js\") are not checked, because the files only exist after a build. The tsconfig outDir / declarationDir of every tsconfig is added automatically."
        },
        "pathmend.disabledRules": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "PM001",
              "PM002",
              "PM003",
              "PM004",
              "PM005",
              "PM006",
              "PM007",
              "PM008",
              "PM009",
              "PM010",
              "PM011",
              "PM012",
              "PM013",
              "PM014",
              "PM015",
              "package-path-not-found",
              "tsconfig-path-not-found",
              "docker-source-not-found",
              "compose-path-not-found",
              "github-actions-path-not-found",
              "codeowners-path-not-found",
              "launch-path-not-found",
              "gitlab-include-not-found",
              "glob-no-matches",
              "outside-workspace",
              "outside-docker-context",
              "markdown-path-not-found",
              "mdx-module-not-found",
              "mdx-attribute-path-not-found",
              "directive-path-not-found"
            ],
            "enumDescriptions": [
              "package-path-not-found: package.json path not found",
              "tsconfig-path-not-found: tsconfig / jsconfig path not found",
              "docker-source-not-found: Dockerfile COPY / ADD source not found",
              "compose-path-not-found: Compose build context / dockerfile not found",
              "github-actions-path-not-found: GitHub Actions path not found",
              "codeowners-path-not-found: CODEOWNERS path not found",
              "launch-path-not-found: launch.json path not found",
              "gitlab-include-not-found: GitLab CI local include not found",
              "glob-no-matches: Glob matches no files",
              "outside-workspace: Path outside the workspace - not checked",
              "outside-docker-context: COPY / ADD source outside the Docker build context",
              "markdown-path-not-found: Markdown link or image path not found",
              "mdx-module-not-found: MDX import or export path not found",
              "mdx-attribute-path-not-found: MDX JSX attribute path not found",
              "directive-path-not-found: Markdown directive path not found",
              "PM001: package.json path not found",
              "PM002: tsconfig / jsconfig path not found",
              "PM003: Dockerfile COPY / ADD source not found",
              "PM004: Compose build context / dockerfile not found",
              "PM005: GitHub Actions path not found",
              "PM006: CODEOWNERS path not found",
              "PM007: launch.json path not found",
              "PM008: GitLab CI local include not found",
              "PM009: Glob matches no files",
              "PM010: Path outside the workspace - not checked",
              "PM011: COPY / ADD source outside the Docker build context",
              "PM012: Markdown link or image path not found",
              "PM013: MDX import or export path not found",
              "PM014: MDX JSX attribute path not found",
              "PM015: Markdown directive path not found"
            ]
          },
          "default": [],
          "description": "Rule IDs or descriptive aliases to turn off."
        },
        "pathmend.severity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "hint"
          ],
          "default": "warning",
          "description": "Severity for broken references. PM010 (outside workspace, not checked) is always Information."
        },
        "pathmend.reportOutsideWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "Show an Information diagnostic (PM010) for paths that resolve outside the workspace. They are never checked either way."
        },
        "pathmend.renameUpdates": {
          "type": "string",
          "enum": [
            "prompt",
            "off"
          ],
          "default": "prompt",
          "description": "After a rename or move in VS Code, offer to update config references that pointed at the old path."
        },
        "pathmend.maxIndexedFiles": {
          "type": "number",
          "default": 20000,
          "description": "Maximum number of workspace files indexed for glob matching and \"did you mean\" suggestions."
        },
        "pathmend.maxConfigFileSizeKB": {
          "type": "number",
          "default": 512,
          "description": "Config files larger than this are skipped."
        },
        "pathmend.mdx.pathAttributes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "src",
            "href"
          ],
          "description": "JSX attributes containing explicit relative file paths."
        },
        "pathmend.markdown.directivePathAttributes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "component",
            "code",
            "files"
          ],
          "description": "Markdown/MDX directive attributes containing explicit relative file paths."
        },
        "pathmend.markdown.multiPathAttributes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "files"
          ],
          "description": "Path attributes whose quoted values contain comma-separated paths."
        }
      }
    },
    "submenus": [
      {
        "id": "pathmend.menu",
        "label": "PathMend",
        "icon": "$(ellipsis)"
      }
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@vscode/test-electron": "^2.5.2",
    "playwright-core": "^1.56.1",
    "vitest": "^3.2.4"
  }
}
